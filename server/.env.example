# Copy to server/.env for local development: cp server/.env.example server/.env
# On Render, set these under the service's Environment tab instead (render.yaml asks for the required ones).

# development locally, production on Render
NODE_ENV=development
# Render sets PORT itself; leave it out there
PORT=4000

# Local:      mongodb://localhost:27017/performance_tracker
# Atlas/prod: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/performance_tracker?appName=Cluster0
MONGODB_URI=mongodb://localhost:27017/performance_tracker

# At least 32 characters. Generate with: openssl rand -hex 32
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=3d

# Where the dashboard runs. Production: your Vercel URL, e.g. https://workplus.vercel.app
# (no trailing slash; separate several with commas)
CLIENT_ORIGIN=http://localhost:5173

# Python AI service. Production: e.g. https://workplus-ai.onrender.com
AI_SERVICE_URL=http://localhost:8000

# Shared secret used by analysis-agent (must match its SERVICE_API_KEY). At least 32 characters.
SERVICE_API_KEY=replace-with-another-long-random-secret

SCREENSHOT_INTERVAL_MINUTES=5
# Screenshots (images and labels) are deleted automatically after this many days
SCREENSHOT_RETENTION_DAYS=3

# One-click demo sign-in for exploring (never enable on a real deployment)
DEMO_MODE=false

# camera-agent: how often the webcam is checked, and how long its labels are kept (no images are ever stored)
CAMERA_INTERVAL_MINUTES=5
CAMERA_RETENTION_DAYS=30

# Storage folders (defaults: server/storage/downloads and server/storage/screenshots).
# On Render, point these at a persistent disk, or files are lost on every deploy.
# DOWNLOADS_DIR=
# SCREENSHOT_DIR=

# Offer the desktop agent installers attached to this repository's latest GitHub Release
# (built by the "Build desktop agent" workflow) instead of the DOWNLOADS_DIR folder.
# On Render it defaults to the repository the service deploys from.
# DOWNLOADS_GITHUB_REPO=Shashank80000/AI-Powered-Employee-Performance-and-Activity-Tracking-System
# Optional GitHub token, raising the API limit of 60 requests an hour per IP (shared between services on Render).
# GITHUB_TOKEN=
