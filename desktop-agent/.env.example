# Base URL of the WorkPlus server API (production: e.g. https://workplus-api.onrender.com/api)
AGENT_API_URL=http://localhost:4000/api
# How often (seconds) an activity snapshot is built
SNAPSHOT_INTERVAL_SECONDS=60
# How often (seconds) buffered snapshots are sent to the server
FLUSH_INTERVAL_SECONDS=300
# Seconds without input before the user counts as idle
IDLE_THRESHOLD_SECONDS=120
# How often (seconds) a screenshot is taken -- ONLY if the person turned screenshots on
# (off by default). If unset, the server's screenshotIntervalMinutes is used, else 300.
SCREENSHOT_INTERVAL_SECONDS=300
