# Node server base URL
SERVER_URL=http://localhost:4000
# Your WorkPlus employee email (the password is always asked for and never stored)
WORKPLUS_EMAIL=
# local: on-device presence detection only (the frame never leaves this computer)
# vision: Claude labels the activity (needs vision consent and an Anthropic API key)
CAMERA_MODE=local
# Which webcam to use (0 = default)
CAMERA_INDEX=0
# Vision mode only
ANTHROPIC_API_KEY=
CAMERA_MODEL=claude-opus-5-5
# Set false on Bedrock / Vertex / Foundry
REFUSAL_FALLBACK=true
# Label frames but don't send anything to the server
DRY_RUN=false
