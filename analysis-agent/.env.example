# Node server (production: e.g. https://workplus-api.onrender.com)
SERVER_URL=http://localhost:4000
# Shared secret sent as X-Service-Key (required; must match the server's value)
SERVICE_API_KEY=change-me

# Anthropic credentials are resolved by the SDK: ANTHROPIC_API_KEY, ANTHROPIC_AUTH_TOKEN,
# or an `ant auth login` profile. Never commit a real key.
ANTHROPIC_API_KEY=

# Model used for classification and summaries (default claude-opus-5-5).
# A cheaper model, e.g. claude-sonnet-5-5 or claude-haiku-4-5, cuts cost.
ANALYSIS_MODEL=claude-opus-5-5
# Server-side refusal fallback (Claude API only). Set to false on Bedrock/Vertex/Foundry.
REFUSAL_FALLBACK=true

# Parallel screenshot/employee workers
MAX_CONCURRENCY=4
# true = call Claude but do not write anything back to the server
DRY_RUN=false
