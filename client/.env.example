# Copy to client/.env.local only if you need to change these locally.
# On Vercel, set VITE_API_URL under Settings → Environment Variables, then redeploy.

# Development: leave empty (Vite proxies /api to the local API).
# Production: your Render API URL, no /api and no trailing slash, e.g. https://workplus-api.onrender.com
VITE_API_URL=

# Development only: where Vite proxies /api (default http://localhost:4000)
# VITE_API_PROXY=http://localhost:4000
